<?xml version="1.0" encoding="utf-8"?>
<!-- One row, four cells wide. minWidth/minHeight follow Android's 70n-30 dp
     sizing: 250dp is four cells, 40dp is one row. minHeight used to be 90dp,
     which launchers round up to two rows, so the widget could not sit as
     4x1 beside the summary widget. It resizes sideways only; below four
     cells the status text would have no room beside the two buttons. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
  android:description="@string/smartlife_sleep_widget_description"
  android:initialLayout="@layout/smartlife_sleep_widget"
  android:minWidth="250dp"
  android:minHeight="40dp"
  android:minResizeWidth="250dp"
  android:minResizeHeight="40dp"
  android:previewLayout="@layout/smartlife_sleep_widget"
  android:resizeMode="horizontal"
  android:targetCellWidth="4"
  android:targetCellHeight="1"
  android:updatePeriodMillis="1800000"
  android:widgetCategory="home_screen" />
