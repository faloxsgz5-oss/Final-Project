{
  "expo": {
    "name": "SmartLife",
    "slug": "smartlife",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon-app-1024.png",
    "scheme": "smartlife",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.smartlife.student",
      "icon": "./assets/brand/icon-app-1024.png",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.smartlife.student",
      "versionCode": 2,
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#F4F5EF",
        "foregroundImage": "./assets/brand/icon-adaptive-foreground.png",
        "monochromeImage": "./assets/brand/icon-adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "output": "static",
      "name": "SmartLife & Budget Balance",
      "shortName": "SmartLife",
      "description": "จัดการชีวิตและการเงินในที่เดียว: ตารางเรียน งาน โน้ต และงบประมาณ พร้อมผู้ช่วย AI",
      "lang": "th",
      "themeColor": "#688a65",
      "backgroundColor": "#e9ebe2",
      "favicon": "./public/icon-pwa-192.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/with-gradle-locale",
      "@react-native-firebase/app",
      "@react-native-firebase/app-check",
      "@react-native-google-signin/google-signin",
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/icon-notification-96.png",
          "color": "#33402A",
          "defaultChannel": "adaptive-scheduling"
        }
      ],
      [
        "@react-native-voice/voice",
        {
          "microphonePermission": "อนุญาตให้ SmartLife ใช้ไมโครโฟนเพื่อพิมพ์ข้อความจากเสียง",
          "speechRecognitionPermission": "อนุญาตให้ SmartLife แปลงเสียงพูดเป็นข้อความ"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/icon-notification-96.png",
          "color": "#33402A",
          "defaultChannel": "smartlife-deadlines"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "อนุญาตให้ SmartLife ใช้กล้องเพื่อสแกนตารางเรียนและใบเสร็จ",
          "photosPermission": "อนุญาตให้ SmartLife เข้าถึงรูปภาพเพื่อสแกนตารางเรียนและใบเสร็จ"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F5EF",
          "image": "./assets/brand/brand-splash.png",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "94ce55bb-a8ea-4213-8fb5-d3ffc8fe3924"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/94ce55bb-a8ea-4213-8fb5-d3ffc8fe3924",
      "requestHeaders": {
        "expo-channel-name": "preview"
      }
    }
  }
}
