{
  "expo": {
    "name": "SmartLife",
    "slug": "smartlife",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "smartlife",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.smartlife.student",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.smartlife.student",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "@react-native-voice/voice",
        {
          "microphonePermission": "อนุญาตให้ SmartLife ใช้ไมโครโฟนเพื่อพิมพ์ข้อความจากเสียง",
          "speechRecognitionPermission": "อนุญาตให้ SmartLife แปลงเสียงพูดเป็นข้อความ"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "อนุญาตให้ SmartLife ใช้กล้องเพื่อสแกนตารางเรียนและใบเสร็จ",
          "photosPermission": "อนุญาตให้ SmartLife เข้าถึงรูปเพื่อสแกนตารางเรียนและใบเสร็จ"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F5EF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "94ce55bb-a8ea-4213-8fb5-d3ffc8fe3924"
      }
    }
  }
}
